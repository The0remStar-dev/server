<!doctype html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <script src="https://cdn.tailwindcss.com"></script>
        <title>Formulaire</title>
    </head>

    <body>
        <nav class="border-b bg-green-600 border-green-300">
            <div class="max-w-6xl mx-auto py-2 bg-green-600 px-6 xl:px-0 flex items-center justify-between">
                <div class="menu-left flex items-center space-x-6">
                    <a href="/" class="py-4 text-lg text-white font-semibold">Node Tutorial</a>

                    <ul class="flex items-center space-x-4">
                        <li><a href="/login" class="hover:bg-green-600 text-white px-2 py-2 rounded-xl">Login</a></li>
                        <li><a href="/register" class="hover:bg-green-600 text-white px-2 py-2 rounded-xl">Sign Up</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="bg-green-100">
            <div class="max-w-lg mx-auto flex flex-wrap p-6">
                <div class="w-full bg-green-600 p-4 rounded-xl">
                    <h1 class="mb-6 text-2xl text-center text-white">Contactez-nous</h1>

                    <% if (success) { %>
                        <div class="mb-4 rounded-xl bg-green-500 p-4 text-white">
                            <p><%= success %></p>
                        </div>
                    <% } %>

                    <form method="POST" action="/formulaire" class="space-y-3">
                        <div class="p-4">
                            <label class="text-white" for="name">Nom</label>
                            <input type="text" name="name" id="name" value="<%= formData.name || '' %>" class="w-full mt-2 py-4 px-6 bg-white rounded-xl" required>
                        </div>
                        <div class="p-4">
                            <label class="text-white" for="email">Email</label>
                            <input type="email" name="email" id="email" value="<%= formData.email || '' %>" class="w-full mt-2 py-4 px-6 bg-white rounded-xl" required>
                        </div>
                        <div class="p-4">
                            <label class="text-white" for="message">Message</label>
                            <textarea name="message" id="message" rows="5" class="w-full mt-2 py-4 px-6 bg-white rounded-xl" required><%= formData.message || '' %></textarea>
                        </div>

                        <div>
                            <button type="submit" class="py-4 rounded-xl px-6 ml-2 mb-2 text-white bg-green-500 hover:bg-green-700">Envoyer</button>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <footer class="bg-green-600">
            <div class="max-w-6xl mx-auto py-10 px-6 xl:px-0 md:flex justify-between">
                <div class="footer-left mb-12 md:mb-0">
                    <h2 class="mb-5 uppercase text-lg text-white">About us</h2>
                    <p class="text-white">Lorem ipsum bla bla bla..</p>
                </div>

                <div class="footer-right">
                    <h2 class="mb-5 uppercase text-lg text-white">Social links</h2>
                    <ul class="space-y-2">
                        <li><a href="#" class="text-white hover:text-green-600">Facebook</a></li>
                        <li><a href="#" class="text-white hover:text-green-600">Twitter</a></li>
                        <li><a href="#" class="text-white hover:text-green-600">Instagram</a></li>
                    </ul>
                </div>
            </div>
        </footer>

        <script src="https://unpkg.com/hyperscript@2.2.0/dist/hyperscript.js"></script>
    </body>
</html>
